    },
    {
      "id_soal": 2,
      "teks_pertanyaan": "... تَذْهَبِيْنَ إِلَى شَاطِئِ البَحْرِ ، يا فَاطِمَةُ ؟ أَذْهَبُ إِلَى شَاطِئِ الْبَحْرِ غَدًا",
